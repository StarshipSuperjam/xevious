{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StarshipSuperjam/xevious/assets/sprite-extraction/schema.json",
  "title": "Xevious sprite extraction manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generator_version",
    "matte",
    "contact_sheet",
    "sheets",
    "frames"
  ],
  "properties": {
    "version": {"const": 1},
    "generator_version": {"const": 1},
    "matte": {"$ref": "#/$defs/rgb"},
    "contact_sheet": {
      "const": "docs/images/sprite-extraction-proof.png"
    },
    "sheets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/sheet"}
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/frame"}
    }
  },
  "$defs": {
    "byte": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "rgb": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/byte"},
        {"$ref": "#/$defs/byte"},
        {"$ref": "#/$defs/byte"}
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "pair": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "size": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 1},
        {"type": "integer", "minimum": 1}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "rect": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 1},
        {"type": "integer", "minimum": 1}
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset",
        "sha256",
        "source",
        "credit",
        "license",
        "excluded_rects"
      ],
      "properties": {
        "asset": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}\\.png$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source": {"type": "string", "minLength": 1},
        "credit": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "excluded_rects": {
          "type": "array",
          "items": {"$ref": "#/$defs/rect"}
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sheet",
        "rect",
        "canvas",
        "anchor",
        "target",
        "family",
        "animation",
        "duration_frames"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[/-][a-z0-9]+)*$"
        },
        "sheet": {"type": "string", "minLength": 1},
        "rect": {"$ref": "#/$defs/rect"},
        "canvas": {"$ref": "#/$defs/size"},
        "anchor": {"$ref": "#/$defs/pair"},
        "target": {
          "enum": ["solvalou", "toroid_sprite_proof"]
        },
        "family": {"type": "string", "minLength": 1},
        "animation": {"type": "string", "minLength": 1},
        "duration_frames": {"type": "integer", "minimum": 1}
      }
    }
  }
}
